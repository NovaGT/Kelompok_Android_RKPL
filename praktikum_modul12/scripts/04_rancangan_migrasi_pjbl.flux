from(bucket: "energi_kampus")
  |> range(start: 2026-11-01T00:00:00Z, stop: 2027-01-01T00:00:00Z)
  |> filter(fn: (r) => r._measurement == "pemakaian" and r.kode_ruangan == "RK-101")
  |> filter(fn: (r) => r._field == "daya_watt" or r._field == "energi_kwh")
  |> pivot(rowKey: ["_time"], columnKey: ["_field"], valueColumn: "_value")
  |> keep(columns: ["_time", "nama_ruangan", "daya_watt", "energi_kwh"])
  |> group()
  |> rename(columns: {_time: "waktu_catat"})
  |> sort(columns: ["waktu_catat"])